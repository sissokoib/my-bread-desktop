{
  "name": "my-bread",
  "version": "1.2.0",
  "description": "My Bread — Logiciel de Gestion de Boulangerie Artisanale",
  "author": "My Bread",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href ./",
    "electron": "electron .",
    "electron:dev": "wait-on http-get://localhost:4200 && electron .",
    "desktop:run": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "desktop:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "desktop:publish": "npm run build && electron-builder --win nsis --publish always",
    "desktop:publish:mac": "npm run build && electron-builder --mac dmg zip --publish always",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "electron-updater": "^6.8.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.mybread.app",
    "productName": "My Bread",
    "publish": [
      {
        "provider": "github",
        "owner": "sissokoib",
        "repo": "my-bread-desktop"
      }
    ],
    "directories": {
      "output": "dist_desktop"
    },
    "files": [
      "dist/my-bread/browser/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Bread"
    },
    "mac": {
      "icon": "electron/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "My Bread",
      "sign": false
    }
  }
}
